# ── Dice Credentials (required) ──
DICE_EMAIL=your_email@example.com
DICE_PASSWORD=your_password_here

# ── Proxy (optional) ──
# PROXY=socks5://user:pass@host:port

# ── Debug (optional) ──
DEBUG=false

# ── Dry Run (optional) ──
# true = locate the Apply button and log it, but never actually submit.
# Also settable per-run via: python3 dice_bot.py --dry-run
DRY_RUN=false

# ── Telegram Notifications (optional) ──
# Set via `python3 setup.py`, or manually. Both required to enable.
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# TELEGRAM_CHAT_ID=your_chat_id
